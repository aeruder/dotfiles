#!/usr/bin/env perl

use feature ':5.14';
use strict;
use warnings 'all';
$^W = 1;

use Tie::IxHash;
use Text::xSV;
use JSON::PP;
use List::MoreUtils qw(natatime zip);

my $CSV = Text::xSV->new();
my $JSON = JSON::PP->new->utf8;

my @headers = $CSV->get_row;

while (my @row = $CSV->get_row) {
    my @combined = zip @headers, @row;
    my $it = natatime 2, @combined;

    tie my %ordered_hash, 'Tie::IxHash';
    while (my ($k, $v) = $it->()) {
        $ordered_hash{$k} = $v;
    }
    print $JSON->encode(\%ordered_hash), "\n";
}
